{\rtf1\ansi\ansicpg1252\deff0\nouicompat\deflang1033{\fonttbl{\f0\fnil\fcharset0 Calibri;}}
{\*\generator Riched20 10.0.19041}\viewkind4\uc1 
\pard\sa200\sl240\slmult1\b\f0\fs28\lang9 EXPERIMENT NO :- 10\b0\fs22\par
\b\fs24 NAME : ANKITA SACHIN KUMBHAR\par
\b0\fs22\par
product_names= []\par
product_prices= []\par
product_qty= []\par
\par
while True:\par
    print("=" *45)\par
    print("   product inventary system")\par
    print("=" *45)\par
    print("1. add product")\par
    print("2. delete product")\par
    print("3. update product price")\par
    print("4. traverse/ display all products")\par
    print("5. search product (by name)")\par
    print("6. sort product by price (Assending)")\par
    print("7.sort product by price (Desending) ")\par
    print("8.sort product by name (Alphabetical) ")\par
    print("9.show costlist/ cheapest product ")\par
    print("10. exit")\par
    print("=" *45)\par
\par
    choice = input("enter your choice(1-10): ").strip()\par
\par
#------add product--------\par
    if choice == '1':\par
            name = input("enter product name:").strip()\par
\par
            if name in product_names:\par
                  print(f"product'\{name\} ' already exits! use update option insted.\\n")\par
            else:\par
                  price = float(input(f"enter price for \{name\}:"))\par
                  qty = int(input(f"enter quantity for \{name\}:"))\par
\par
                  product_names.append(name)\par
                  product_prices.append(price)\par
                  product_qty.append(qty)\par
                  print(f"product '\{name\}' added successfully.\\n")\par
\par
    \par
    elif choice =="2" :\par
          name = input("enter product name to delete:").strip()\par
\par
          if name in product_names:\par
                index = product_names.index(name)\par
                product_names.pop(index)\par
                product_prices.pop(index)\par
                product_qty.pop(index)\par
                print(f"product'\{name\}' deleted successfully.\\n")\par
          else:\par
                print(f"product '\{name\}' not found.\\n") \par
\par
\par
    \par
    elif choice =="3":            \par
          name = input("enter product name to update price:").strip()\par
\par
          if name in product_names:\par
                index = product_names.index(name)\par
                new_price = float(input(f"enter new price for \{name\}:"))\par
                product_prices[index] = new_price\par
                print(f"price for'\{name\}' update successfully.\\n")\par
\par
          else:\par
                print(f"product '\{name\}' not found.\\n")  \par
\par
\par
    \par
\par
    elif choice =="4":\par
          if len(product_names)== 0:\par
                print("no products to display.\\n")\par
\par
          else:\par
                print("\\n\{:<5\} \{:<20\} \{:<10\}  \{:<10\}".format("no.", "name", "price", "qty"))      \par
                print("-" *45)\par
                for i in range(len(product_names)):\par
                    print("\{:<5\} \{:<20\}   \{:<10\} \{:<30\}". format(i+1, product_names[i],product_prices[i], product_qty[i]))\par
                print()                            \par
\par
\par
    \par
    elif choice == "5":\par
          name = input("enter the product name to search :").strip()\par
\par
          if name in product_names:\par
                index = product_names.index(name) \par
                print(f"Found -> Name:\{product_names[index]\},"\par
                      f"price: \{product_prices[index]\},Qty: \{product_qty[index]\}\\n")   \par
          else:\par
                print(f"product '\{name\}' not found.\\n")          \par
\par
    \par
    elif choice == "6":\par
          if len(product_names) == 0:\par
                print("no products to sort.\\n") \par
          else: \par
\par
                combined= list(zip(product_prices, product_names, product_qty )) \par
                combined.sort()\par
\par
                product_prices= [item[0] for item in combined]  \par
                \par
                product_prices= [item[1] for item in combined]\par
                product_prices= [item[2] for item in combined]\par
\par
                print("products sorted by price(ascending).\\n")\par
\par
\par
    \par
    elif choice == "7":\par
          if len(product_names) == 0:\par
                print("no products to sort.\\n") \par
          else: \par
    \par
                combined= list(zip(product_prices, product_names, product_qty )) \par
                combined.sort(reverse=True)\par
    \par
                product_prices= [item[0] for item in combined]  \par
                    \par
                product_prices= [item[1] for item in combined]\par
                product_prices= [item[2] for item in combined]\par
    \par
                print("products sorted by price(descending).\\n")            \par
\par
\par
    \par
    \par
    elif choice == "8":\par
          if len(product_names) == 0:\par
                print("no products to sort.\\n") \par
          else: \par
    \par
                combined= list(zip(product_prices, product_names, product_qty )) \par
                combined.sort()\par
    \par
                product_prices= [item[0] for item in combined]  \par
                    \par
                product_prices= [item[1] for item in combined]\par
                product_prices= [item[2] for item in combined]\par
    \par
                print("products sorted alphabetically by name.\\n")                                          \par
                                    \par
    \par
    elif choice == "9":\par
          if len(product_prices) == 0:\par
                print("no products available.\\n") \par
          else:\par
                highest = max(product_prices) \par
                lowest = min(product_prices)\par
\par
                costliest_index = product_prices.index(highest)\par
                cheapest_index = product_prices.index(lowest)\par
\par
                print("\\n --------price summary------")\par
                print(f"costliest product : \{product_names[costliest_index]\} (price: \{highest\})")\par
                print(f"cheapest product : \{product_names[cheapest_index]\} (price: \{lowest\})")\par
                print()\par
\par
    elif choice == "10" :\par
          print("exiting program. thank you!")          \par
          break\par
\par
    else:\par
          print("invalid choice. please enter a number between 1 and 10.\\n")\par
\par
OUTPUT :- \par
